# Agency OS — environment template.
# Copy to .env at the REPO ROOT and fill in. This file is committed: never put a
# real value in it. Variable names and grouping mirror PLAN.md §8 exactly.
#
# One .env at the root serves both apps:
#   - apps/worker loads it via `tsx --env-file-if-exists=../../.env`
#   - apps/web loads it in next.config.ts (Next.js only reads apps/web/.env itself)
#   - the operator scripts load it via `tsx --env-file-if-exists=.env`
# In production there is no file: Vercel and Railway supply these as platform
# variables, and a platform variable always wins over the file.
#
# Comments live on their own line, never after a value — a trailing comment ends
# up inside the value in some .env parsers.

# --- Supabase ---------------------------------------------------------------

# Project URL from Supabase → Settings → API. Web + worker. Step 1.
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key, safe in the browser, RLS applies. Web. Step 1.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Worker and operator scripts only — bypasses RLS, never expose to the browser. Steps 1, 4, 5.
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth -------------------------------------------------------------------

# The single email allowed to sign in via magic link; checked in Next.js middleware. Step 2.
ALLOWED_EMAIL=

# --- Anthropic --------------------------------------------------------------

# Anthropic API key used by packages/core/src/llm.ts. Step 4.
ANTHROPIC_API_KEY=

# --- Gmail ------------------------------------------------------------------

# OAuth client ID for the Gmail API (Google Cloud project). Step 6.
GOOGLE_CLIENT_ID=
# OAuth client secret paired with GOOGLE_CLIENT_ID. Step 6.
GOOGLE_CLIENT_SECRET=
# Long-lived refresh token for the owner's Gmail account; re-auth = replace this. Step 6.
GMAIL_REFRESH_TOKEN=
# Pub/Sub topic for Gmail users.watch push notifications. Step 8.
GMAIL_PUBSUB_TOPIC=
# Shared secret authenticating the Pub/Sub → worker webhook. Step 8.
GMAIL_WEBHOOK_SECRET=

# --- Web Push ---------------------------------------------------------------

# VAPID public key for the PWA push subscription. Step 7.
VAPID_PUBLIC_KEY=
# VAPID private key used by the worker to sign push messages. Step 7.
VAPID_PRIVATE_KEY=

# --- Compliance footer (GDPR — all four elements required) ------------------

# Sender identity shown in the footer of every outbound email. Step 6.
BUSINESS_NAME=
# Physical address, required on every outbound email. Step 6.
BUSINESS_ADDRESS=
# Public URL of the privacy policy, linked in the footer. Step 6.
PRIVACY_POLICY_URL=

# --- Behaviour --------------------------------------------------------------

# Default true in development — agents run, tasks are created, Gmail send is stubbed. Steps 5, 6.
DRY_RUN=true
# Process timezone; all timestamps stored as UTC, local logic uses Europe/Athens. Step 1.
TZ=Europe/Athens
