{
  "name": "agency-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agency OS — internal operations app for a solo web development business. pnpm workspaces root.",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "dev:web": "pnpm --filter @agency/web dev",
    "dev:worker": "pnpm --filter @agency/worker dev",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p scripts --noEmit",
    "test": "pnpm -r --if-present test",
    "seed": "tsx --env-file-if-exists=.env scripts/seed-brain.ts",
    "import:contacts": "tsx --env-file-if-exists=.env scripts/import-contacts.ts"
  },
  "dependencies": {
    "@agency/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "csv-parse": "^5",
    "tsx": "^4",
    "typescript": "^5.7.0"
  }
}
