{
  "name": "@agency/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared types, Supabase clients, settings and env access for Agency OS. Consumed as TypeScript source — never built to dist.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cadence": "./src/cadence.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5"
  }
}
